          "response": []
        },
        {
          "name": "Filtrar Platos Comprados por Estado de Pago",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/purchased-dishes/paid?paid=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "purchased-dishes", "paid"],
